# Large generated stem WAVs stay local unless you opt into LFS
# (app build still uses Fixtures/Audio/Idilio-stems when present)
Fixtures/Audio/Idilio-stems/*.wav

# Build tooling virtualenv (tools/README.md)
tools/.venv/
# Downloaded pretrained checkpoints — build inputs, never shipped, never committed
tools/checkpoints/
# Conversion / parity / install logs (tee'd during model export)
*_export.log

# Bundled Core ML models (~412 MB) are hosted on GitHub Releases, not in git.
# Fetch them with `make models` (tools/fetch_models.sh) or regenerate via
# tools/convert_htdemucs.py. The manifest JSON stays tracked — it's the contract.
SoundView/Resources/*.mlpackage/

# DEBUG-only htdemucs_6s reference stems (~312 MB, fetched/local, never in git)
Fixtures/Audio/Idilio-stems/
